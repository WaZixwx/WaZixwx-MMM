[flake8]
max-line-length = 140
extend-ignore =
    E203,
    E402,
    E501,
    W503
exclude =
    .git,
    __pycache__,
    build,
    dist,
    *.egg-info,
    test_audio,
    .pytest_cache,
    .venv,
    venv,
    mmm_env
per-file-ignores =
    mmm/ui/*.py: E501
    mmm/ui/banners.py: C901
    mmm/ui/console.py: C901
    mmm/ui/progress.py: C901
